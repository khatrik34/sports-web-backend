# Copy to .env and fill in real values. Never commit .env.
#
# The application refuses to start without a valid APP_JWT_SECRET, and the compose file
# refuses to start without DB_PASSWORD / APP_JWT_SECRET.

# ---- PostgreSQL -------------------------------------------------------------
DB_NAME=sportsweb
DB_USERNAME=sportsweb
DB_PASSWORD=change-me-strong-database-password

# ---- JWT --------------------------------------------------------------------
# Base64 encoded HMAC key, at least 32 bytes decoded.
# Generate with:  openssl rand -base64 48
APP_JWT_SECRET=

# ---- Public site / CORS -----------------------------------------------------
# Origin of the public website and of the admin panel (comma separated).
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Absolute base URL used for canonical links and sitemap entries.
APP_PUBLIC_SITE_BASE_URL=http://localhost:3000
# Article URL shape of the existing website (verified from sports-web: /news/{slug}).
APP_ARTICLE_PATH_TEMPLATE=/news/{slug}
# Language used by the Google News sitemap feed.
APP_PUBLIC_SITE_LANGUAGE=en

# ---- First administrator (optional, one-off) --------------------------------
# Set to true only for the first start, then set it back to false.
APP_BOOTSTRAP_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=Site Administrator

# ---- API docs ---------------------------------------------------------------
# Set to false in production to stop advertising the API surface.
APP_DOCS_PUBLIC=true

# ---- Demo content (optional) ------------------------------------------------
# Append db/demo to load a ready-made dataset (4 teams, 12 players, a series with fixtures,
# scorecard, commentary, 5 news articles, 3 videos, homepage sections). Never use in production.
# APP_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo
